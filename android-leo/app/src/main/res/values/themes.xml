<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Leo" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/leo_accent</item>
        <item name="colorPrimaryDark">@color/leo_bg</item>
        <item name="colorAccent">@color/leo_accent</item>
        <item name="android:windowBackground">@color/leo_bg</item>
        <item name="android:statusBarColor">@color/leo_surface</item>
        <item name="android:navigationBarColor">@color/leo_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/leo_text_primary</item>
        <item name="android:textColorSecondary">@color/leo_text_secondary</item>
    </style>

    <style name="Theme.Leo.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/leo_accent</item>
        <item name="colorPrimaryDark">@color/leo_surface_light</item>
        <item name="colorAccent">@color/leo_accent</item>
        <item name="android:windowBackground">@color/leo_bg_light</item>
        <item name="android:statusBarColor">@color/leo_surface_light</item>
        <item name="android:navigationBarColor">@color/leo_surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/leo_text_primary_light</item>
        <item name="android:textColorSecondary">@color/leo_text_secondary_light</item>
    </style>
</resources>
