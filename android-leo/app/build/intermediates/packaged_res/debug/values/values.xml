<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="leo_accent">#6366F1</color>
    <color name="leo_accent_light">#818CF8</color>
    <color name="leo_agent_bubble">#16213E</color>
    <color name="leo_bg">#0F0F0F</color>
    <color name="leo_bg_light">#FFFFFF</color>
    <color name="leo_divider">#2A2A2A</color>
    <color name="leo_divider_light">#E0E0E0</color>
    <color name="leo_error">#EF4444</color>
    <color name="leo_pinned">#FBBF24</color>
    <color name="leo_success">#10B981</color>
    <color name="leo_surface">#1A1A1A</color>
    <color name="leo_surface_light">#F5F5F5</color>
    <color name="leo_surface_variant">#242424</color>
    <color name="leo_surface_variant_light">#EBEBEB</color>
    <color name="leo_text_hint">#666666</color>
    <color name="leo_text_hint_light">#999999</color>
    <color name="leo_text_primary">#EAEAEA</color>
    <color name="leo_text_primary_light">#1A1A1A</color>
    <color name="leo_text_secondary">#A0A0A0</color>
    <color name="leo_text_secondary_light">#666666</color>
    <color name="leo_user_bubble">#1E1E2E</color>
    <color name="leo_warning">#F59E0B</color>
    <string name="accessibility_service_description">Leo requires accessibility access to autonomously control UI elements, fill forms, click buttons, and navigate apps on your device. This is the God-Mode control layer. SHS LAB.</string>
    <string name="accessibility_service_label">Leo System Agent</string>
    <string name="app_name">Leo</string>
    <style name="Theme.Leo" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/leo_accent</item>
        <item name="colorPrimaryDark">@color/leo_bg</item>
        <item name="colorAccent">@color/leo_accent</item>
        <item name="android:windowBackground">@color/leo_bg</item>
        <item name="android:statusBarColor">@color/leo_surface</item>
        <item name="android:navigationBarColor">@color/leo_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/leo_text_primary</item>
        <item name="android:textColorSecondary">@color/leo_text_secondary</item>
    </style>
    <style name="Theme.Leo.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/leo_accent</item>
        <item name="colorPrimaryDark">@color/leo_surface_light</item>
        <item name="colorAccent">@color/leo_accent</item>
        <item name="android:windowBackground">@color/leo_bg_light</item>
        <item name="android:statusBarColor">@color/leo_surface_light</item>
        <item name="android:navigationBarColor">@color/leo_surface_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/leo_text_primary_light</item>
        <item name="android:textColorSecondary">@color/leo_text_secondary_light</item>
    </style>
</resources>